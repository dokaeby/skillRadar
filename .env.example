GITHUB_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
ADMIN_TOKEN=
DATABASE_URL=sqlite:///./skillradar.db
# Supabase/Postgres 예: postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SCHEDULE_HOUR=6
SCHEDULE_TIMEZONE=Asia/Seoul
APP_ENV=debug
TRANSLATE_FALLBACK=true
# LangGraph 큐레이터 / LangSmith (선택)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skillradar
LANGSMITH_TRACING=false
LLM_JUDGE_MODEL=gemini-3.5-flash-lite
CHECKPOINT_PATH=
